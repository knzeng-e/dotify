{
  "name": "dotify-bulletin-segment-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --import tsx --test prototype.test.mjs live-transport.test.mjs aac-fixture.test.mjs native-rpc.test.mjs addressing.test.mjs readdress-aac.test.mjs",
    "measure": "node --import tsx measure.mjs",
    "canary": "node --import tsx canary.mjs",
    "test:host": "node --import tsx --test host-server.test.mjs host-browser.test.mjs",
    "prepare:aac": "node --import tsx aac-fixture.mjs",
    "host": "node --import tsx host-server.mjs",
    "prepare:addressing": "node --import tsx addressing-fixture.mjs",
    "prepare:blake-aac": "node --import tsx readdress-aac.mjs",
    "pipeline": "node --import tsx pipeline-canary.mjs",
    "test:pipeline": "node --import tsx --test pipeline.test.mjs nonce-transport.test.mjs pipeline-cli.test.mjs",
    "measure:pipeline": "node --import tsx measure-pipeline.mjs",
    "inspect:pipeline": "node inspect-pipeline.mjs",
    "build:mobile": "node --import tsx mobile-package.mjs",
    "test:mobile": "node --import tsx --test mobile-package.test.mjs mobile-reports.test.mjs",
    "test:mobile-browser": "node --import tsx --test mobile-browser.test.mjs",
    "probe:writer": "node --import tsx writer-probe.mjs",
    "test:continuity": "node --import tsx --test continuity.test.mjs finalization.test.mjs",
    "test:continuity-browser": "node --import tsx --test continuity-browser.test.mjs finalization-browser.test.mjs",
    "continuity": "node --import tsx continuity.mjs",
    "test:protected": "node protected-rehearsal.mjs"
  },
  "dependencies": {
    "@ipld/dag-pb": "4.2.0",
    "@parity/bulletin-sdk": "0.5.0",
    "@polkadot-labs/hdkd": "0.0.32",
    "@polkadot-labs/hdkd-helpers": "0.0.34",
    "ipfs-unixfs": "12.0.0",
    "ipfs-unixfs-importer": "16.1.5",
    "multiformats": "14.0.5",
    "polkadot-api": "3.3.0",
    "tsx": "4.19.2",
    "@noble/hashes": "2.4.0"
  }
}
