          "name": "_loupePallet",
          "type": "address"
        },
        {
          "internalType": "address",
          "name": "_ownershipPallet",
          "type": "address"
        },
        {
          "internalType": "address",
          "name": "_registryPallet",
          "type": "address"
        },
        {
          "internalType": "address",
          "name": "_nftPallet",
          "type": "address"
        },
        {
          "internalType": "address",
          "name": "_royaltiesPallet",
          "type": "address"
        },
        {
          "internalType": "address",
          "name": "_accessPallet",
          "type": "address"
        }
      ],
      "stateMutability": "nonpayable",
      "type": "constructor"
    },
