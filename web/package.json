{
	"name": "dotify-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22 <23",
		"npm": ">=10"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 5273",
		"signal": "SIGNAL_PORT=8788 node server/signaling.mjs",
		"test:signal": "node --test server/signaling.test.mjs server/signaling-smoke.test.mjs",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"dev:listen": "concurrently -n signal,web -c magenta,cyan \"npm:signal\" \"npm:dev\"",
		"build": "tsc -b && vite build",
		"build:bulletin": "tsc -b && vite build --config vite.bulletin.config.ts",
		"build:product-devnet": "npm run generate:product-catalog-bootstrap && tsc -b && vite build --config vite.product.config.ts --mode product-devnet",
		"build:product-devnet:beacons": "VITE_DOTIFY_ROOM_BEACONS=on npm run build:product-devnet",
		"deploy:bulletin": "node scripts/deploy-bulletin.cjs",
		"deploy:product-devnet:check-mnemonic": "node -e \"if (!process.env.MNEMONIC?.trim()) { console.error('MNEMONIC is required for Product DevNet deploy. Export the DotNS owner mnemonic before running npm run deploy:product-devnet.'); process.exit(1); }\"",
		"deploy:product-devnet": "npm run deploy:product-devnet:check-mnemonic && npm run build:product-devnet && npx --yes --package @polkadot-community-foundation/polkadot-app-deploy@0.13.1 pad ./dist-product dotify-test01.dot --env devnet --js-merkle --config ./polkadot-app-deploy.config.ts --mnemonic \"$MNEMONIC\" --no-transfer-to-signedin-user",
		"deploy:product-devnet:beacons": "VITE_DOTIFY_ROOM_BEACONS=on npm run deploy:product-devnet",
		"smoke:production-env": "node scripts/production-env-smoke.mjs",
		"smoke:devnet": "node scripts/devnet-endpoint-smoke.mjs",
		"smoke:signal": "node scripts/signaling-smoke.mjs",
		"lint": "eslint .",
		"fmt": "prettier --write 'src/**/*.{ts,tsx}' 'server/**/*.mjs' 'scripts/**/*.mjs' README.md",
		"fmt:check": "prettier --check 'src/**/*.{ts,tsx}' 'server/**/*.mjs' 'scripts/**/*.mjs' README.md",
		"generate:product-catalog-bootstrap": "node scripts/generate-product-catalog-bootstrap.mjs",
		"generate:product-catalog-bootstrap:strict": "node scripts/generate-product-catalog-bootstrap.mjs --strict",
		"generate:cdm": "node scripts/generate-cdm-manifest.mjs",
		"generate:cdm-metadata": "node scripts/generate-cdm-metadata.mjs",
		"upload:cdm-metadata": "node scripts/upload-cdm-metadata.mjs",
		"update-types": "papi update",
		"codegen": "papi generate",
		"preview": "vite preview --host 0.0.0.0 --port 4273"
	},
	"dependencies": {
		"@parity/product-sdk": "0.23.0",
		"@parity/product-sdk-descriptors": "0.10.0",
		"@parity/product-sdk-host": "0.16.0",
		"@parity/product-sdk-statement-store": "0.6.5",
		"@polkadot-api/descriptors": "file:.papi/descriptors",
		"@polkadot-apps/chain-client": "^2.0.5",
		"@polkadot-apps/descriptors": "^1.0.1",
		"@polkadot-apps/keys": "^0.4.4",
		"@polkadot-apps/signer": "^1.1.0",
		"@polkadot-apps/utils": "^0.4.0",
		"@vitejs/plugin-react": "^4.3.4",
		"engine.io-client": "6.6.6",
		"lucide-react": "^1.8.0",
		"pinata": "^2.5.5",
		"polkadot-api": "^1.23.3",
		"qrcode": "^1.5.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"viem": "^2.53.1"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.61.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.0.1",
		"postcss": "^8.4.49",
		"prettier": "^3.8.1",
		"tailwindcss": "^3.4.15",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^6.0.1",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^3.2.6"
	}
}
