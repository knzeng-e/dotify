FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
# Signaling uses only the server/shared JavaScript runtime. Frontend lifecycle
# hooks (including the Host codec patch) have no inputs or consumers here.
RUN npm ci --omit=dev --ignore-scripts

COPY server ./server
COPY shared ./shared

# Start Node directly so SIGTERM reaches the graceful shutdown handler.
USER node
CMD ["node", "server/signaling.mjs"]
