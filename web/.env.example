# Browser-exposed Vite variables.
# Copy this file to web/.env.local for local development.

# Socket.IO signaling server used by shared listening rooms.
VITE_SIGNAL_URL=http://localhost:8788

# Product host integration is disabled for ordinary local/Netlify builds.
# The checked-in `.env.product-devnet` profile sets these for `dotify-test01.dot`.
VITE_DOTIFY_HOST_MODE=off
# VITE_DOTIFY_PRODUCT_ID=dotify-test01.dot
# VITE_PUBLIC_APP_URL=https://dotify-test01.dev-dot.li

# Local development endpoints used when selecting the local network preset.
VITE_LOCAL_WS_URL=ws://localhost:9944
VITE_LOCAL_ETH_RPC_URL=http://localhost:8545

# Optional global Polkadot WS override. Leave empty to use local/testnet defaults.
# VITE_WS_URL=

# Paseo Bulletin Chain RPC used for metadata JSON publication.
VITE_BULLETIN_WS_URL=wss://paseo-bulletin-rpc.polkadot.io

# Backend API service URL.
# When set, cover and metadata uploads are routed through the backend API (Ticket 02).
# Audio uploads via backend require CONTENT_KEY_MASTER_SECRET in services/api/.env.
# Leave unset for local demo mode (uses VITE_PINATA_JWT instead).
VITE_DOTIFY_API_URL=http://localhost:8790

# Pinata direct-browser upload — DEMO/LOCAL MODE ONLY.
# Only used when VITE_DOTIFY_API_URL is not set.
# Use a restricted Pinata JWT (upload-only scope). Do NOT use an unrestricted token.
# In production, set VITE_DOTIFY_API_URL and configure PINATA_JWT in services/api/.env.
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://paseo-ipfs.polkadot.io
VITE_IPFS_READ_GATEWAYS=https://paseo-ipfs.polkadot.io,https://ipfs.io,https://dweb.link

# Best-effort browser-side audio encryption secret.
# Must be 32 bytes as hex. It is bundled into the frontend, so treat it as
# demo protection rather than production DRM.
# VITE_CONTENT_SECRET=

# Node-only variables used by npm scripts in web/ (signaling server).
SIGNAL_PORT=8788
SIGNAL_HOST=0.0.0.0
# Comma-separated allowed origins. Use explicit origins in production;
# SIGNAL_ORIGIN (singular) is still honored for backwards compatibility.
SIGNAL_ORIGINS=http://localhost:5273
# Native hosts may omit Origin on Socket.IO handshakes. Keep false unless the
# deployment has a non-browser host; this does not allow literal Origin: null.
# SIGNAL_ALLOW_MISSING_ORIGIN=false
# Hard room lifetime (default 6 hours) and host liveness timeout (default 120s).
# SIGNAL_ROOM_TTL_MS=21600000
# SIGNAL_HOST_TIMEOUT_MS=120000
# Per-room listener cap (default 24).
# SIGNAL_MAX_LISTENERS=24
BULLETIN_ACCOUNT=Alice

# Optional browser-visible TURN fallback for listening rooms. Prefer the API
# TURN grant path (`services/api`: TURN_URLS + TURN_REST_SECRET) for production
# so relay secrets remain server-side. Without TURN, WebRTC fails for listeners
# behind symmetric NAT. VITE_TURN_URL accepts comma-separated turn:/turns: URLs.
# VITE_TURN_URL=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
