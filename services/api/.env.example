# Dotify API — backend service environment variables.
# Copy this file to services/api/.env for local development.

# Port the API server listens on.
API_PORT=8790

# Frontend origin allowed by CORS.
API_ORIGIN=http://localhost:5273
# Comma-separated origins take precedence over API_ORIGIN when set.
# API_ORIGINS=https://muzinga.netlify.app,https://dotify-test01.dev-dot.li,https://dotify-test01.app.dev-dot.li,https://dotify-test01.app.dot.li,https://dotify-test01.dot,polkadot://dotify-test01.dot,polkadot://app.dotify-test01.dot

# Paseo Asset Hub EVM RPC. Required for wallet-signed content-key requests:
# the key route resolves the owning artist runtime via the directory and calls
# musicAccCanAccess before any key is delivered. If unset, key delivery fails
# closed (denied with reason RPC_UNAVAILABLE).
PASEO_ASSET_HUB_RPC=https://eth-rpc-testnet.polkadot.io/
# Optional read-only native archive for Product gift/tip receipts. No signer.
PASEO_ASSET_HUB_NATIVE_RPC=https://asset-hub-paseo-rpc.n.dwellir.com
# Random server-only token (32–256 characters), identical to signaling's
# SIGNAL_NATIVE_RECEIPT_SERVICE_TOKEN. Never use a VITE_ variable.
# NATIVE_RECEIPT_SERVICE_TOKEN=

# Deployed contract addresses (see deployments.json at the repo root).
# DOTIFY_DIRECTORY_ADDRESS is required for content-key access checks.
DOTIFY_FACTORY_ADDRESS=
DOTIFY_DIRECTORY_ADDRESS=
DOTIFY_CHAIN_ID=420420417

# Persisted catalog read model. The API loads this snapshot before contacting
# RPC, then advances it from confirmed ArtistDirectory/SmartRuntime events and
# periodically reconciles it against complete on-chain enumeration.
CATALOG_SNAPSHOT_PATH=.data/catalog.json
CATALOG_POLL_INTERVAL_MS=10000
CATALOG_RECONCILE_INTERVAL_MS=300000
CATALOG_STALE_AFTER_MS=60000
CATALOG_CONFIRMATIONS=2
# W37: one shared RPC budget, resumable block ranges, bounded address filters.
CATALOG_READ_CONCURRENCY=8
CATALOG_LOG_BLOCK_RANGE=1000
CATALOG_LOG_ADDRESS_BATCH=100

# Master secret for per-track content-key derivation. Used by BOTH
# /api/uploads/audio (server-side AES-256-GCM encryption before pinning) and
# /api/tracks/:contentHash/key-request (key delivery after an eip191 or
# product-sr25519-v1 signed, on-chain-verified access check). Must be at least
# 32 random bytes encoded as hex. Never expose this value. When no versioned
# map is configured, this value backs release-bound dotify-content-key-v2 only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_KEY_MASTER_SECRET=

# Optional explicit key-version custody. Set CONTENT_KEY_ACTIVE_VERSION to a
# future value such as dotify-content-key-v3, and keep every retained version in
# CONTENT_KEY_MASTER_SECRETS. The value is a JSON object whose values are 32+
# byte hex secrets. Back it up in a real secret manager before setting it; Fly
# secrets cannot be read back later.
# CONTENT_KEY_ACTIVE_VERSION=dotify-content-key-v3
# CONTENT_KEY_MASTER_SECRETS={"dotify-content-key-v2":"<old-hex>","dotify-content-key-v3":"<new-hex>"}

# Deploy-time commit SHA surfaced by GET /version (Ticket 10). Set by CI or
# the Docker build; dev checkouts fall back to `git rev-parse HEAD`.
GIT_COMMIT_SHA=

# Pinata JWT for server-side IPFS pinning (Ticket 02+).
# This token must never appear in frontend env files or be bundled into the Vite build.
# Use a scoped Pinata key with pinFileToIPFS and pinJSONToIPFS permissions only.
PINATA_JWT=

# Short-lived, one-use artist upload capabilities and rolling in-memory quotas.
# The API deployment is intentionally single-instance. A restart clears quota
# counters and invalidates every outstanding upload/session capability.
UPLOAD_AUTH_TTL_SECONDS=300
UPLOAD_QUOTA_WINDOW_SECONDS=3600
UPLOAD_PRINCIPAL_BYTES_PER_WINDOW=209715200
UPLOAD_GLOBAL_BYTES_PER_WINDOW=2147483648
UPLOAD_PRINCIPAL_CONCURRENCY=2
UPLOAD_GLOBAL_CONCURRENCY=2

# TURN relay grants for reliable WebRTC rooms across mobile/carrier/symmetric
# NAT boundaries. TURN_URLS is public relay configuration; TURN_REST_SECRET is
# backend-only and shared with the relay's REST auth mechanism (for example
# Coturn static-auth-secret). The API returns short-lived credentials from
# GET /api/turn/grant. Use TURN_USERNAME/TURN_CREDENTIAL only for rotated
# DevNet/static credentials when REST auth is unavailable.
# TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:443?transport=tcp
# TURN_REST_SECRET=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_TTL_SECONDS=3600
# Shared with the signaling service's SIGNAL_TURN_CAPABILITY_SECRET. Use a
# separate random value from TURN_REST_SECRET (32+ characters).
# TURN_CAPABILITY_SECRET=

# Shared native contribution receipts; mount a persistent single-writer volume in production.
NATIVE_CONTRIBUTION_SNAPSHOT_PATH=.data/native-contributions.json

# New-publication streaming: provision fresh durable custody and a separately
# isolated encoder first. Both URL and dedicated token are required together.
# No worker setting means audio publication is unavailable (HTTP 503).
# STREAMING_WORKER_URL=http://dotify-encoder.internal:8791
# STREAMING_WORKER_TOKEN=<dedicated-service-token-at-least-32-characters>
STREAMING_STATE_PATH=.data/streaming

# W33 public ciphertext CDN origin; no token/query/path. Leave unset until the
# gateway serves the current streaming CID without authentication on all hosts.
# Existing dedicated candidate: https://chocolate-selected-ocelot-159.mypinata.cloud
# MEDIA_EDGE_URL=https://chocolate-selected-ocelot-159.mypinata.cloud
# Optional dedicated IPFS origin for API relay misses (same public gateway).
# MEDIA_IPFS_GATEWAY=https://chocolate-selected-ocelot-159.mypinata.cloud

# Optional read-only Bulletin ciphertext relay for Web and Host recovery.
# Public HTTPS RPC origin only; pinned DevNet genesis, no credentials or path.
# Does not select the publication worker's provider or configure a signer.
# BULLETIN_MEDIA_RPC_URL=https://bulletin-paseo.tservices.es:8443

# W36: session auth has its own secret; never reuse a content-key secret.
# SESSION_SECRET=<32 random bytes encoded as 64 hex characters>
# Shared deployment only, after explicit migration (see shared-api-state.md):
STATE_STORE=local
API_ROLE=combined
# DATABASE_URL=postgresql://<application-role>@<private-db>/<database>
# STATE_NAMESPACE=dotify
# SESSION_EPOCH=<preserve the existing stable server-side epoch>
# SESSION_PREVIOUS_SECRET=<temporary previous signing input>
# SESSION_PREVIOUS_SECRET_UNTIL=<absolute UTC deadline, at most 24h ahead>
# Edge only: CUSTODY_SERVICE_URL=http://dotify-custody.internal:8790
# Both roles: CUSTODY_SERVICE_TOKEN=<dedicated transport token>
